# Agent Brain Environment Configuration
# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key (for AI features)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Supabase (database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption key for storing OAuth tokens (generate with: openssl rand -hex 32)
AUTH_ENCRYPTION_KEY=your-64-char-hex-key-here

# Agent Brain URL (used in generated instructions for Claude/Codex sessions)
# Default: http://localhost:3030
# Change to your Tailscale IP or domain for remote access, e.g.:
# AB_URL=http://100.x.x.x:3030
AB_URL=http://localhost:3030

# ── Optional ──────────────────────────────────────────────────────────────────

# ── HTTP API Auth (recommended for non-localhost exposure) ────────────────────
# When Agent Brain is reachable over a network (Tailscale, LAN), enable HTTP
# Basic Auth so only authenticated clients can read/write memory, answer
# checkpoints, send mailbox messages, etc. Without this, ANY device that can
# reach :3030 can drive your agent sessions.
#
# Browsers (phone, laptop) will be prompted once and cache the creds.
# The MCP server, hooks, and ab-checkpoint CLI auto-pick these up from this
# same .env file and send the header automatically.
# AB_AUTH_ENABLED=true
# AB_API_USER=admin
# AB_API_PASSWORD=  # 32+ random chars (openssl rand -base64 24)

# OpenAI API key (for AI briefings with GPT models)
# OPENAI_API_KEY=sk-your-key-here

# Notification service (ntfy.sh)
# NTFY_TOPIC=your-topic-name

# GitHub (for webhook integration)
# GITHUB_TOKEN=ghp_your-token
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Google OAuth (for Gmail/Calendar sync)
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REDIRECT_URI=http://localhost:3030/api/email/accounts/callback

# Notion (if using Notion integration)
# NOTION_API_KEY=ntn_your-key

# Airtable (if using Airtable integration)
# AIRTABLE_API_KEY=pat_your-key

# ── Fly.io Runner (if deploying to Fly.io) ────────────────────────────────────

# FLY_ACCESS_TOKEN=your-fly-token
# GCLOUD_PROJECT=your-project
# GCLOUD_SERVICE_KEY={"type":"service_account",...}
